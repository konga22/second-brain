---
// 세컨드 브레인 홍보 페이지 (설계서 3.1). 앱 기능을 돌리지 않고, 지식 데이터도 다루지 않는다.
// 숫자는 개발 중 실측값(docs/토큰분석.md, 설계서 5.8), 요금은 추천안(docs/요금제분석.md, 미결정 5 가안).
import '../styles/global.css';

const problems = [
  { title: '지식이 흩어진다', body: 'AI와 나눈 대화, 메모, 회의 내용이 도구마다 흩어져 있어 다시 찾기 어렵습니다.' },
  { title: 'AI가 같은 실수를 반복한다', body: '새 대화를 시작하면 지난번에 바로잡아 준 내용을 기억하지 못합니다.' },
  { title: '직접 만들기는 어렵다', body: '메모리 파일·훅·MCP를 설정하면 되지만, 개발 지식과 시간이 필요합니다.' },
];

const features = [
  { name: '대화가 저절로 지식으로', body: 'Claude Code 대화에서 결정과 이유, 문제와 해결이 확정되면 묻지 않고 초안으로 저장합니다. 앱의 정리 대기에서 확인만 하면 됩니다.' },
  { name: '뇌 그래프', body: '노트가 주제별로 모이고, 같은 핵심어를 가진 노트끼리 추천 연결이 생깁니다. 목록·타임라인·정리 보드로도 봅니다.' },
  { name: 'AI 도구 연동', body: '플러그인 하나로 Claude Code가 내 노트를 찾아 답합니다. 질문과 맞는 노트는 미리 붙여 주어 찾는 수고도 줄입니다.' },
  { name: '실수 노트', body: '"아니야, 이렇게 해" 하고 고친 내용을 검증 에이전트가 규칙으로 만들고, 다음 관련 요청에 자동으로 붙입니다.' },
  { name: '앱 안 AI 질문', body: '내 노트를 근거로 답하고, 어떤 노트를 봤는지 함께 보여 줍니다.' },
  { name: '할 일', body: '노트와 대화에서 나온 할 일을 AI가 추천하고, 받으면 목록에 들어갑니다.' },
];

const numbers = [
  { value: '0토큰', label: '관계없는 요청에 붙는 안내', note: '맞는 노트·규칙이 있을 때만 넣습니다' },
  { value: '−31%', label: 'AI가 쓰는 입력 토큰', note: '맞는 노트를 미리 붙인 뒤, 실제 Claude Code 150번 측정' },
  { value: '43ms', label: '노트 1만 개에서 찾기', note: 'brain find, 목표 50ms' },
  { value: '95%', label: '자연어 질문으로 찾기', note: '검색 시험 질문 20개, 상위 5개 안' },
];

const faqs = [
  { q: '내 노트가 서버로 가나요?', a: '아니요. 노트는 내 맥의 지식 폴더(md 파일)에만 저장됩니다. Claude Code 연동은 우리 서버를 거치지 않습니다. 앱 안 AI 질문을 쓸 때만 질문과 관련 노트 일부(제목·요약·앞부분)가 AI로 전달되고, 서버에는 저장하지 않습니다.' },
  { q: 'Obsidian과 같이 쓸 수 있나요?', a: '네. 지식 폴더는 평범한 md 파일이라 Obsidian으로 열 수 있고, 밖에서 고친 내용도 앱이 바로 반영합니다.' },
  { q: '어떤 AI 도구를 지원하나요?', a: '지금은 Claude Code를 지원합니다. Codex 연동을 준비하고 있습니다.' },
  { q: '앱을 처음 열 때 "확인되지 않은 개발자" 경고가 떠요', a: '아직 Apple 공증 전이라 그렇습니다. 경고 창을 닫고 시스템 설정 → 개인정보 보호 및 보안에서 아래쪽 [그래도 열기]를 누르면 됩니다(처음 한 번만). 우클릭 → [열기]로는 열리지 않을 수 있습니다.' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>세컨드 브레인 — AI와 나눈 대화가 지식이 되는 곳</title>
    <meta name="description" content="Claude Code 대화에서 결정과 해결 방법을 모아 내 맥에만 저장하고, 다음 질문에서 AI가 꺼내 쓰게 하는 macOS 앱." />
  </head>
  <body>
    <header class="sticky top-0 z-20 border-b border-line bg-bg/85 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
        <a href="#" class="font-semibold tracking-tight">세컨드 브레인 <span class="text-xs font-normal text-faint">가칭</span></a>
        <div class="hidden gap-6 text-sm text-muted sm:flex">
          <a href="#features" class="hover:text-ink">기능</a>
          <a href="#how" class="hover:text-ink">동작 방식</a>
          <a href="#pricing" class="hover:text-ink">요금제</a>
          <a href="#faq" class="hover:text-ink">자주 묻는 질문</a>
        </div>
        <a href="#download" class="rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white">macOS 앱 받기</a>
      </nav>
    </header>

    <main>
      <!-- 첫 화면 -->
      <section class="mx-auto grid max-w-6xl gap-10 px-5 pb-16 pt-14 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:pt-20">
        <div>
          <p class="mb-4 inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent-text">macOS 데스크톱 앱 · Claude Code 연동</p>
          <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
            AI와 나눈 대화가<br />지식이 되는 곳
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
            Claude Code 대화에서 정한 것과 해결한 방법을 저절로 모아 내 맥에만 저장합니다. 다음에 비슷한 걸 물으면 AI가 그 노트를 꺼내 쓰고, 지난번에 바로잡아 준 실수는 반복하지 않습니다.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#download" class="rounded-lg bg-accent px-5 py-3 font-medium text-white">macOS 앱 받기</a>
            <a href="#how" class="rounded-lg border border-line bg-surface px-5 py-3 font-medium">어떻게 동작하나요</a>
          </div>
        </div>
        <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-line" style="background: radial-gradient(circle at 50% 45%, #2b2550 0%, #16132a 55%, #0d0b18 100%)">
          <div id="graph" class="absolute inset-0" aria-label="샘플 노트로 그린 뇌 그래프" role="img"></div>
          <p class="pointer-events-none absolute bottom-3 left-4 text-xs text-[#d6d3e88c]">샘플 노트로 그린 뇌 그래프 · 노드를 끌어 볼 수 있어요</p>
        </div>
      </section>

      <!-- 문제 -->
      <section class="border-y border-line bg-surface">
        <div class="mx-auto max-w-6xl px-5 py-16">
          <h2 class="text-2xl font-bold tracking-tight">이런 문제를 풉니다</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-3">
            {problems.map((p, i) => (
              <div>
                <p class="text-sm font-semibold text-accent-text">0{i + 1}</p>
                <h3 class="mt-2 text-lg font-semibold">{p.title}</h3>
                <p class="mt-2 leading-relaxed text-muted">{p.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 기능 -->
      <section id="features" class="mx-auto max-w-6xl scroll-mt-16 px-5 py-16">
        <h2 class="text-2xl font-bold tracking-tight">할 수 있는 것</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f) => (
            <div class="rounded-xl border border-line bg-surface p-5">
              <h3 class="font-semibold">{f.name}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{f.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 동작 방식 -->
      <section id="how" class="scroll-mt-16 border-y border-line bg-surface">
        <div class="mx-auto max-w-6xl px-5 py-16">
          <h2 class="text-2xl font-bold tracking-tight">어떻게 동작하나요</h2>
          <p class="mt-3 max-w-2xl text-muted">지식은 내 맥에만 있습니다. Claude Code가 지식을 찾을 때는 우리 서버를 거치지 않습니다.</p>

          <div class="mt-8 grid gap-6 lg:grid-cols-2">
            <div class="rounded-xl border border-line p-5">
              <p class="text-sm font-semibold text-accent-text">연동한 AI가 찾을 때 — 서버 0번</p>
              <ol class="mt-4 space-y-3">
                <li class="flex gap-3"><span class="font-semibold text-faint">1</span><span><b>Claude Code</b>에 평소처럼 묻습니다</span></li>
                <li class="flex gap-3"><span class="font-semibold text-faint">2</span><span><b>훅·스킬</b>이 맞는 노트만 골라 붙이고(관계없으면 0토큰), 고쳐 준 실수는 세션마다 한 줄씩 늘 보여 줍니다</span></li>
                <li class="flex gap-3"><span class="font-semibold text-faint">3</span><span>더 필요하면 AI가 <code class="rounded bg-raised px-1.5 py-0.5 text-sm">brain find</code>로 찾습니다</span></li>
                <li class="flex gap-3"><span class="font-semibold text-faint">4</span><span><b>내 맥의 지식 폴더</b>(md 파일 + 검색 색인)에서 답을 꺼냅니다</span></li>
              </ol>
            </div>
            <div class="rounded-xl border border-line p-5">
              <p class="text-sm font-semibold text-accent-text">앱 안에서 AI에게 물을 때</p>
              <ol class="mt-4 space-y-3">
                <li class="flex gap-3"><span class="font-semibold text-faint">1</span><span>앱이 내 맥에서 관련 노트 5개를 찾습니다</span></li>
                <li class="flex gap-3"><span class="font-semibold text-faint">2</span><span>질문과 노트 <b>일부</b>(제목·요약·앞부분)만 AI 게이트웨이로 보냅니다</span></li>
                <li class="flex gap-3"><span class="font-semibold text-faint">3</span><span>답과 근거 노트가 돌아옵니다. 서버에는 저장하지 않습니다</span></li>
                <li class="flex gap-3"><span class="font-semibold text-faint">4</span><span>답이 틀리면 [틀렸어] → 실수 노트로 남아 다음에 반영됩니다</span></li>
              </ol>
            </div>
          </div>
        </div>
      </section>

      <!-- 숫자 -->
      <section class="mx-auto max-w-6xl px-5 py-16">
        <h2 class="text-2xl font-bold tracking-tight">숫자로 보면</h2>
        <p class="mt-3 text-muted">개발하면서 직접 잰 값입니다.</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {numbers.map((n) => (
            <div class="rounded-xl border border-line bg-surface p-5">
              <p class="text-3xl font-bold tracking-tight">{n.value}</p>
              <p class="mt-2 font-medium">{n.label}</p>
              <p class="mt-1 text-sm text-faint">{n.note}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 데이터 보호 -->
      <section class="border-y border-line bg-surface">
        <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-[1fr_1.4fr]">
          <h2 class="text-2xl font-bold tracking-tight">내 지식은 내 맥에</h2>
          <ul class="space-y-3 leading-relaxed text-muted">
            <li>노트·그래프·실수 노트·할 일은 모두 내 맥의 지식 폴더에 md 파일로 저장됩니다. 서버 데이터베이스에는 넣지 않습니다.</li>
            <li>서버는 로그인과 요금제, 앱 안 AI 질문 전달만 합니다. 요청 내용은 로그에 남기지 않습니다.</li>
            <li>API 키 같은 비밀값은 저장하기 전에 가립니다. 가져온 대화 속 지시문이 AI를 움직이지 않도록 데이터 경계를 둡니다.</li>
            <li>지식 폴더째 압축해 백업하고 복원할 수 있습니다.</li>
          </ul>
        </div>
      </section>

      <!-- 요금제 -->
      <section id="pricing" class="mx-auto max-w-6xl scroll-mt-16 px-5 py-16">
        <h2 class="text-2xl font-bold tracking-tight">요금제</h2>
        <p class="mt-3 text-muted">Claude Code 연동은 우리 서버를 쓰지 않아 무료에서도 무제한입니다. 앱 안 AI 질문은 쓴 만큼 크레딧이 줄고, 앱에는 "남은 질문 약 N회"로 보입니다. <span class="text-faint">(금액은 가안)</span></p>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <div class="rounded-xl border border-line bg-surface p-6">
            <h3 class="font-semibold">무료</h3>
            <p class="mt-2 text-3xl font-bold">0원</p>
            <ul class="mt-5 space-y-2 text-muted">
              <li>Claude Code 연동 무제한</li>
              <li>노트·뇌 그래프·실수 노트·할 일</li>
              <li>AI 크레딧 월 60 (질문 약 23회)</li>
            </ul>
          </div>
          <div class="rounded-xl border-2 border-accent bg-surface p-6">
            <h3 class="font-semibold">Pro</h3>
            <p class="mt-2 text-3xl font-bold">월 12,900원</p>
            <p class="text-sm text-faint">연 129,000원 (두 달 무료)</p>
            <ul class="mt-5 space-y-2 text-muted">
              <li>무료의 모든 기능</li>
              <li>AI 크레딧 월 3,000 (질문 약 1,160회)</li>
              <li>답을 고치면 실수 노트로 검증</li>
              <li>가져온 대화 자동 묶음 이름</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- 자주 묻는 질문 -->
      <section id="faq" class="scroll-mt-16 border-t border-line bg-surface">
        <div class="mx-auto max-w-3xl px-5 py-16">
          <h2 class="text-2xl font-bold tracking-tight">자주 묻는 질문</h2>
          <div class="mt-6 divide-y divide-line">
            {faqs.map((f) => (
              <details class="group py-4">
                <summary class="cursor-pointer list-none font-medium">
                  <span class="mr-2 inline-block text-faint transition group-open:rotate-90">›</span>{f.q}
                </summary>
                <p class="mt-3 pl-5 leading-relaxed text-muted">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- 다운로드 -->
      <section id="download" class="mx-auto max-w-6xl scroll-mt-16 px-5 py-20 text-center">
        <h2 class="text-3xl font-bold tracking-tight">곧 내려받을 수 있어요</h2>
        <p class="mx-auto mt-3 max-w-xl text-muted">Apple Silicon(M1 이상) 맥, macOS 14 이상. 지금은 개발 중이라 내려받기를 준비하고 있습니다.</p>
        <span class="mt-8 inline-block cursor-not-allowed rounded-lg bg-raised px-6 py-3 font-medium text-faint" aria-disabled="true">macOS 앱 받기 (준비 중)</span>
      </section>
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-2 px-5 py-6 text-sm text-faint">
        <p>세컨드 브레인(가칭) · 김민상 · 대림대학교 기말 프로젝트 2026</p>
        <p>개인정보처리방침 (준비 중)</p>
      </div>
    </footer>

    <script>
      import { mountGraph } from '../scripts/graph';
      const el = document.getElementById('graph');
      if (el) mountGraph(el);
    </script>
  </body>
</html>
