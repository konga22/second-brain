# 의존성 (npm install로 다시 받는다)
node_modules/

# macOS·USB가 만드는 파일
.DS_Store
._*

# Word가 문서를 열 때 만드는 임시 파일
~$*

# 시안 작업 폴더 (최종본만 docs/시안/에 복사해 둔다)
.codex/temp/

# Flutter·Dart가 만드는 파일 (flutter create 기본값)
.dart_tool/
.flutter-plugins-dependencies
build/
.idea/
*.iml
.vscode/
macos/Flutter/ephemeral/
macos/Pods/
**/xcuserdata/

# Supabase 프로젝트 주소·공개 키 (예시는 env/supabase.example.json). AI API 키는 여기에도 두지 않는다.
env/supabase.json

# brain CLI 빌드 결과 (tool/build_brain.sh가 만든다)
assets/brain/bin/
assets/brain/lib/
assets/brain/SOURCE_HASH

# 설치 파일 (tool/make_dmg.sh가 만든다)
dist/
